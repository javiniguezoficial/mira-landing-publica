# ─────────────────────────────────────────────────────────────
# MIRA Platform — Variables de entorno
# Copia este archivo como .env.local y rellena los valores
# NUNCA subas .env.local a git
# ─────────────────────────────────────────────────────────────

# Supabase — obtén estos valores en https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Solo necesario en el servidor (edge functions, middleware)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# URL base de la app (sin trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
