# ─────────────────────────────────────────────────────────────────────────────
# MIRA Platform — Variables de entorno
#
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local a git. NUNCA incluyas valores reales en este archivo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtén estos valores en: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo necesario en el servidor (Server Actions, middleware). No llega al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── URL base de la aplicación ─────────────────────────────────────────────────
# Sin trailing slash. En local: http://localhost:3000
# En producción: https://demo.mirapricing.com
NEXT_PUBLIC_APP_URL=

# ── Configuración general ─────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Variables futuras — Módulo de monetización (empresa externa)
# Añadir cuando el módulo de Stripe esté aprobado e integrado
# ─────────────────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Variables futuras — Gestor documental de facturas (empresa externa)
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_STORAGE_BUCKET_INVOICES=

# ─────────────────────────────────────────────────────────────────────────────
# Emails transaccionales de Soporte (Bloque 2)
#
# Sin estas variables la aplicación FUNCIONA IGUAL: los tickets y las respuestas
# se guardan y se ven en pantalla. Lo único que ocurre es que no se envía correo
# y queda registrado en el servidor qué variable falta. Nada se pierde.
# La configuración SMTP NO es requisito para arrancar la aplicación.
#
# El transporte es SMTP (nodemailer) contra el correo corporativo de cPanel.
# Cambiar de proveedor es escribir otro `src/lib/email/<proveedor>.ts`.
#
# ⚠️  Esto es INDEPENDIENTE del SMTP de Supabase Auth. Son dos sistemas:
#     · confirmación de alta y recuperación de contraseña → SMTP del panel de
#       Supabase (Authentication → SMTP Settings);
#     · avisos de tickets y respuestas → estas variables.
#     Pueden usar la MISMA cuenta de cPanel, pero se configuran por separado.
# ─────────────────────────────────────────────────────────────────────────────

# OBLIGATORIA para enviar. Servidor SMTP de la cuenta corporativa (cPanel).
SMTP_HOST=

# OPCIONAL. Por defecto 465. Usa 465 con TLS implícito o 587 con STARTTLS.
SMTP_PORT=465

# OPCIONAL. Si se omite se deduce del puerto: 465 → true, cualquier otro → false.
# `true` = TLS desde el primer byte. `false` = STARTTLS.
SMTP_SECURE=true

# OBLIGATORIA para enviar. Cuenta con la que autenticarse en el servidor.
# Puede coincidir o no con EMAIL_FROM, según cómo esté dada de alta en cPanel.
SMTP_USER=

# OBLIGATORIA para enviar. Contraseña del buzón.
# ⚠️  SECRETO. No se registra, no se devuelve en ningún error y no debe
#     escribirse nunca en este archivo, en los tests ni en la documentación.
#     Se configura SOLO en las variables de entorno del despliegue.
SMTP_PASSWORD=

# OBLIGATORIA para enviar. Remitente que verá el destinatario.
# Debe ser una cuenta del dominio corporativo para no romper SPF/DKIM.
# Admite dos formas:
#   soporte@tudominio.com
#   MIRA <soporte@tudominio.com>
EMAIL_FROM=

# OPCIONAL. Buzón interno que recibe el aviso de cada ticket nuevo.
# Si se deja vacío se usa `platform_settings.support_email` (Admin →
# Configuración). Si tampoco está, se omite SOLO el aviso interno: la
# confirmación al usuario se envía igual.
SUPPORT_NOTIFICATION_EMAIL=

# OPCIONAL. URL pública ABSOLUTA y https del logotipo para la cabecera de los
# correos. Sin ella la cabecera usa el nombre «MIRA» en texto, que se ve bien.
# No se admiten rutas relativas ni http: un correo se abre fuera de la app.
MIRA_EMAIL_LOGO_URL=

# NOTA: `NEXT_PUBLIC_APP_URL` (más arriba) también es OBLIGATORIA para enviar
# correo: es la base de los enlaces «Ver en MIRA» y del `emailRedirectTo` de los
# correos de Supabase Auth.
